    {
      "parameters": {
        "options": {
          "systemMessage": "Eres una recepcionista virtual experta para una clínica de podología. Tu objetivo es agendar citas de manera eficiente y amable.\n\nFlujo de trabajo:\n1. Saluda al usuario.\n2. Si desea agendar una cita:\n   a. Consulta los servicios disponibles usando 'get_services'.\n   b. Consulta los profesionales disponibles usando 'get_professionals'.\n   c. Consulta las sedes disponibles usando 'get_sedes'.\n   d. Solicita al usuario el servicio, profesional, sede y fecha/hora deseada.\n   e. Solicita el número de documento del paciente.\n   f. Verifica si el paciente existe o regístralo usando 'register_patient'.\n   g. Intenta agendar la cita usando 'book_appointment'.\n3. Confirma la cita al usuario con los detalles.\n4. Responde siempre de forma concisa y profesional."
        }
      },
      "type": "n8n-nodes-base.aiAgent",
      "typeVersion": 1.1,
      "position": [220, 0],
      "id": "ai_agent_node",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "redisHost": "localhost",
        "redisPort": 6379,
        "database": 0
      },
      "type": "n8n-nodes-base.memoryRedis",
      "typeVersion": 1,
      "position": [220, 200],
      "id": "redis_memory",
      "name": "Redis Memory"
    },
    {
      "parameters": {
        "name": "get_services",
